# Pix (obrigatório) — chave e dados exatamente como cadastrados no banco da Casey
PIX_KEY=casey@exemplo.com
PIX_RECEIVER_NAME=Casey Sobrenome
PIX_RECEIVER_CITY=Sao Paulo

# Supabase (obrigatório em produção) — Project Settings > API
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Painel admin — e-mails autorizados (separados por vírgula). Crie o usuário em Authentication > Users.
ADMIN_EMAILS=casey@exemplo.com

# Endereço público do site, usado nos links dos convites (sem barra no final)
SITE_URL=https://casey-formatura.com.br

# Segredo para anonimizar IPs no limite de tentativas (opcional; usa a service role se vazio)
RATE_LIMIT_SECRET=

# Somente desenvolvimento (sem Supabase): login local do painel
DEV_ADMIN_PASSWORD=
DEV_ADMIN_SESSION_SECRET=
